# Copy to .env and fill in. Never share this file.

# --- AI provider (optional) ---
# Empty AI_API_KEY = no AI: the bot negotiates with fixed rules, free.
#
# Free: Google Gemini (key from https://aistudio.google.com/apikey, no card needed)
#   AI_API_KEY=<gemini key>
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-2.5-flash
#
# Free: Groq (key from https://console.groq.com/keys)
#   AI_API_KEY=<groq key>
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b
#
# Paid: OpenAI
#   OPENAI_API_KEY=<openai key>
#   OPENAI_MODEL=gpt-5.5
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Bale bot for alerts: create one with @botfather in Bale, send it a message,
# then run: python get_chat_id.py
BALE_BOT_TOKEN=
BALE_CHAT_ID=

# Negotiation range (toman)
LIST_PRICE=2700000
FLOOR_PRICE=2100000
